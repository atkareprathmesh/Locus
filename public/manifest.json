{
  "manifest_version": 3,
  "name": "Locus",
  "version": "0.1.1",
  "description": "Your place on the web. Bookmarks, tasks, habits, calendar, notes and journaling \u2014 every time you open a new tab.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "Open Locus",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "history",
    "topSites",
    "favicon",
    "alarms",
    "notifications",
    "downloads"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
